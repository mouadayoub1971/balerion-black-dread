# =============================================================================
# SERVERLESS CHATBOT - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
# AWS Region where resources will be deployed
AWS_REGION=us-east-1

# AWS Account ID (12-digit number)
AWS_ACCOUNT_ID=123456789012

# AWS CLI Profile (optional, defaults to 'default')
AWS_PROFILE=default

# -----------------------------------------------------------------------------
# Google Gemini API Configuration
# -----------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/
# Used for both chat (Gemini 2.0 Flash) and image generation (Imagen)
GEMINI_API_KEY=your-gemini-api-key-here

# SSM Parameter Store path for Gemini API key (where it's stored in AWS)
# This is used by Lambda functions to retrieve the key securely
GEMINI_API_KEY_PARAM=/chatbot/gemini-api-key

# -----------------------------------------------------------------------------
# DynamoDB Configuration
# -----------------------------------------------------------------------------
# Table name for storing chat messages and image metadata
DYNAMODB_TABLE=ChatMessages

# DynamoDB billing mode (PAY_PER_REQUEST or PROVISIONED)
DYNAMODB_BILLING_MODE=PAY_PER_REQUEST

# -----------------------------------------------------------------------------
# S3 Configuration
# -----------------------------------------------------------------------------
# S3 bucket for storing generated images
# Must be globally unique - replace [unique-id] with your unique identifier
S3_BUCKET_IMAGES=chatbot-images-[unique-id]

# S3 bucket for hosting frontend static files
S3_BUCKET_FRONTEND=chatbot-frontend-[unique-id]

# S3 region (usually same as AWS_REGION)
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# OpenWeatherMap API (Optional - for weather function)
# -----------------------------------------------------------------------------
# Get free API key from: https://openweathermap.org/api
# Free tier: 1,000 calls/day, no credit card required
# Leave empty to use mock weather data
OPENWEATHER_API_KEY=

# -----------------------------------------------------------------------------
# Lambda Function Configuration
# -----------------------------------------------------------------------------
# Lambda runtime
LAMBDA_RUNTIME=nodejs18.x

# Lambda memory allocation (MB) - adjust based on usage
LAMBDA_MEMORY_SIZE=256

# Lambda timeout (seconds) - max 30s for API Gateway
LAMBDA_TIMEOUT=30

# Lambda log retention (days)
LOG_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# API Gateway Configuration
# -----------------------------------------------------------------------------
# API Gateway stage name
API_STAGE=prod

# API Gateway type (HTTP or REST)
# HTTP API is cheaper - recommended for this project
API_TYPE=HTTP

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
# Use * for all origins or specify your domain
CORS_ALLOWED_ORIGINS=*

# Allowed HTTP methods
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Allowed headers
CORS_ALLOWED_HEADERS=Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token

# -----------------------------------------------------------------------------
# Deployment Configuration
# -----------------------------------------------------------------------------
# Serverless Framework service name
SERVICE_NAME=serverless-chatbot

# Deployment stage (dev, staging, prod)
STAGE=dev

# Stack name for CloudFormation
STACK_NAME=serverless-chatbot-stack

# -----------------------------------------------------------------------------
# Optional: Additional Free APIs for Function Calling
# -----------------------------------------------------------------------------
# These are optional and can extend the chatbot's capabilities

# ExchangeRate API (1,500 requests/month free)
# Get from: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=

# IP Geolocation API (45 requests/minute free, no key needed)
# API: https://ip-api.com/

# -----------------------------------------------------------------------------
# Development & Testing
# -----------------------------------------------------------------------------
# Local development port for serverless-offline
LOCAL_PORT=3000

# Enable debug logging (true/false)
DEBUG=false

# Mock external APIs for testing (true/false)
MOCK_APIS=false

# -----------------------------------------------------------------------------
# Security & Monitoring
# -----------------------------------------------------------------------------
# Enable X-Ray tracing (true/false)
ENABLE_XRAY=false

# Enable detailed CloudWatch metrics (true/false)
ENABLE_DETAILED_METRICS=false

# SNS topic ARN for error notifications (optional)
ERROR_NOTIFICATION_TOPIC=

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Store secrets in AWS SSM Parameter Store:
#    aws ssm put-parameter --name "/chatbot/gemini-api-key" --value "YOUR_KEY" --type SecureString
# 4. Create S3 buckets:
#    aws s3 mb s3://chatbot-images-[unique-id]
#    aws s3 mb s3://chatbot-frontend-[unique-id]
# 5. Create DynamoDB table (see tasks.md Phase 2)
# 6. Deploy: npm run deploy
# =============================================================================
